# Trusting the main CELS Nginx to send the real user IP address
set_real_ip_from 140.221.28.60;
set_real_ip_from 140.221.28.61;
set_real_ip_from 140.221.28.62;
# External CELS Nginx
set_real_ip_from 140.221.25.27;
set_real_ip_from 140.221.25.3;
set_real_ip_from 140.221.25.28;
set_real_ip_from 140.221.25.29;
real_ip_header X-Forwarded-For;

# Gunicorn v1 service (port 8000)
upstream gunicorn_v1 {
    server 127.0.0.1:8000;
}

# Gunicorn v2 service (port 8001)
upstream gunicorn_v2 {
    server 127.0.0.1:8001;
}

# HTTPS server
server {

    # Port 443 for encrypted traffic
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    # Self signed certs generated by the ssl-cert package
    # Don't use them in a production server!
    include snippets/snakeoil.conf;

    server_name _;

    # V2 API Swagger documentation at /
    location = / {
        proxy_pass http://gunicorn_v2;
        include proxy_params;
    }

    # API v1 - port 8000
    location /api/v1 {
        proxy_pass http://gunicorn_v1;
        include proxy_params;
        proxy_set_header SCRIPT_NAME /api/v1;

        access_log /var/log/nginx/api.v1.access.log;
        error_log /var/log/nginx/api.v1.error.log info;
    }

    # API v2 - port 8001
    location /api/v2 {
        proxy_pass http://gunicorn_v2;
        include proxy_params;
        proxy_set_header SCRIPT_NAME /api/v2;

        access_log /var/log/nginx/api.v2.access.log;
        error_log /var/log/nginx/api.v2.error.log info;
    }

    # Nginx logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;
}
